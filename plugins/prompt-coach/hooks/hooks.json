{
  "description": "Prompt coach: restates vague prompts and stops bare pastes; at session start loads the coach profile the team lead approved (Google Drive). Fails open.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/coach.js"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/sync.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
